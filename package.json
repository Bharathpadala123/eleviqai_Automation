{
  "name": "eleviqAI",
  "version": "1.0.0",
  "description": "Production-ready multi-agent Playwright automation framework using TypeScript and POM.",
  "main": "index.js",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test --project=chromium",
    "test:headed": "bddgen && playwright test --project=chromium --headed",
    "test:chrome": "bddgen && playwright test --project=chromium",
    "test:regression": "bddgen && playwright test --project=chromium --grep @regression",
    "test:report": "playwright show-report",
    "report:allure": "allure generate --clean -o allure-report allure-results && allure open allure-report",
    "typecheck": "tsc --noEmit",
    "clean:logs": "node -e \"const fs=require('fs');['logs'].forEach(d=>{if(fs.existsSync(d))fs.rmSync(d,{recursive:true,force:true})})\""
  },
  "keywords": [
    "playwright",
    "automation",
    "typescript",
    "pom"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@faker-js/faker": "^10.5.0",
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.0.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "faker": "^6.6.6",
    "fs-extra": "^11.3.6",
    "ortoni-report": "^4.10.0",
    "playwright": "1.65.1",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2",
    "winston": "^3.19.0"
  }
}
